# 服务端口
PORT=3001

# 访问 B 站接口所需登录态 cookie（从浏览器复制，至少包含 SESSDATA / bili_jct / buvid3）。
# 不配也能抓部分公开数据，但弹幕/评论完整度和风控通过率会下降。
BILI_COOKIE=

# LangChain ChatDeepSeek。未配置时仍会抓取和展示原始数据，但 AI 报告会明确失败并允许重试。
# 模型与推理强度可用 DEEPSEEK_MODEL / DEEPSEEK_REASONING_EFFORT 覆盖，默认 deepseek-v4-flash / medium。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_REASONING_EFFORT="low"  # 'low' | 'medium' | 'high'

# 可选：LangSmith 调用链追踪。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bili-ai-feedback
